{
    "Name": "Office365GroupsActivityStorage",
    "Description": "Get the total storage used across all group mailboxes and group sites.",
    "Utility": "Microsoft365",
    "Service": "Office365Group",
    "Type": "Tenant",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getOffice365GroupsActivityStorage",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ]
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportDate",
                "Expression": "Report Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "MailboxStorageUsedByte",
                "Expression": "Mailbox Storage Used (Byte)"
            },
            {
                "Name": "SiteStorageUsedByte",
                "Expression": "Site Storage Used (Byte)"
            }
        ]
    }
}