{
    "Name": "BrowserUserDetail",
    "Description": "Get a report that provides the browser (Microsoft Edge) used by users when they access the Microsoft 365 services over a selected period.",
    "Utility": "Microsoft365",
    "Service": "Office365",
    "Type": "User",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getBrowserUserDetail",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ]
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "UserPrincipalName",
                "Expression": "User Principal Name"
            },
            {
                "Name": "Edge",
                "Expression": "Edge"
            }
        ]
    }
}