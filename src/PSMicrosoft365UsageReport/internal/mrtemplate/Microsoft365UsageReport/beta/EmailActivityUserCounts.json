    "Utility": "Microsoft365",
    "Service": "ExchangeOnline",
    "Type": "Tenant",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getEmailActivityUserCounts",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ]
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportDate",
                "Expression": "Report Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "Send",
                "Expression": "Send"
            },
            {
                "Name": "Receive",
                "Expression": "Receive"
            },
            {
                "Name": "Read",
                "Expression": "Read"
            },
            {
                "Name": "MeetingCreated",
                "Expression": "Meeting Created"
            },
            {
                "Name": "MeetingInteracted",
                "Expression": "Meeting Interacted"
            }
        ]
    }
}