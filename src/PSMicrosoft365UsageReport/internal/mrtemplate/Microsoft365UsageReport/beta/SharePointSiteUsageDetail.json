{
    "Name": "SharePointSiteUsageDetail",
    "Description": "Get details about SharePoint site usage.",
    "Utility": "Microsoft365",
    "Service": "SharepointOnLine",
    "Type": "User",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getSharePointSiteUsageDetail",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ],
            "Date": "YYYY-MM-DD"
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "OwnerPrincipalName",
                "Expression": "Owner Principal Name"
            },
            {
                "Name": "OwnerDisplayName",
                "Expression": "Owner Display Name"
            },
            {
                "Name": "IsDeleted",
                "Expression": "Is Deleted"
            },
            {
                "Name": "LastActivityDate",
                "Expression": "Last Activity Date"
            },
            {
                "Name": "SiteId",
                "Expression": "Site Id"
            },
            {
                "Name": "SiteURL",
                "Expression": "Site URL"
            },
            {
                "Name": "SiteSensitivityLabelId",
                "Expression": "Site Sensitivity Label Id"
            },
            {
                "Name": "ExternalSharing",
                "Expression": "External Sharing"
            },
            {
                "Name": "UnmanagedDevicePolicy",
                "Expression": "Unmanaged Device Policy"
            },
            {
                "Name": "GeoLocation",
                "Expression": "Geo Location"
            },
            {
                "Name": "FileCount",
                "Expression": "File Count"
            },
            {
                "Name": "ActiveFileCount",
                "Expression": "Active File Count"
            },
            {
                "Name": "PageViewCount",
                "Expression": "Page View Count"
            },
            {
                "Name": "Visited Page Count",
                "Expression": "Visited Page Count"
            },
            {
                "Name": "AnonymousLinkCount",
                "Expression": "Anonymous Link Count"
            },
            {
                "Name": "CompanyLinkCount",
                "Expression": "Company Link Count"
            },
            {
                "Name": "SecureLinkForGuestCount",
                "Expression": "Secure Link For Guest Count"
            },
            {
                "Name": "SecureLinkForMemberCount",
                "Expression": "Secure Link For Member Count"
            },
            {
                "Name": "StorageUsedByte",
                "Expression": "Storage Used (Byte)"
            },
            {
                "Name": "StorageAllocatedByte",
                "Expression": "Storage Allocated (Byte)"
            },
            {
                "Name": "RootWebTemplate",
                "Expression": "Root Web Template"
            }
        ]
    }
}