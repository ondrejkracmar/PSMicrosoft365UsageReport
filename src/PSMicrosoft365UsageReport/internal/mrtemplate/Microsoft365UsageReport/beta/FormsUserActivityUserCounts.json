{
    "Name": "FormsUserActivityUserCounts",
    "Description": "Get a report that provides the total number of designers or responders who perform Microsoft Forms activities over a selected period.",
    "Utility": "Microsoft365",
    "Service": "Forms",
    "Type": "Tenant",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getFormsUserActivityUserCounts",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ]
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "UserPrincipalName",
                "Expression": "User Principal Name"
            },
            {
                "Name": " CreatedCount",
                "Expression": "Created Count"
            },
            {
                "Name": " RespondedCount",
                "Expression": "Responded Count"
            },
            {
                "Name": " LastActivityDate",
                "Expression": "Last Activity Date"
            }
        ]
    }
}