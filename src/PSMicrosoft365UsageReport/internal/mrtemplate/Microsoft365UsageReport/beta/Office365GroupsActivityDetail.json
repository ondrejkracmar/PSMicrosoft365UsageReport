{
    "Name": "Office365GroupsActivityDetail",
    "Description": "Get details about Microsoft 365 groups activity by group.",
    "Utility": "Microsoft365",
    "Service": "Office365Group",
    "Type": "Tenant",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getOffice365GroupsActivityDetail",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ],
            "Date": "YYYY-MM-DD"
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "GroupId",
                "Expression": "Group Id"
            },
            {
                "Name": "GroupDisplayName",
                "Expression": "Group Display Name"
            },
            {
                "Name": "IsDeleted",
                "Expression": "Is Deleted"
            },
            {
                "Name": "OwnerPrincipalName",
                "Expression": "Owner Principal Name"
            },
            {
                "Name": "LastActivityDate",
                "Expression": "Last Activity Date"
            },
            {
                "Name": "GroupType",
                "Expression": "Group Type"
            },
            {
                "Name": "MemberCount",
                "Expression": "Member Count"
            },
            {
                "Name": "ExternalMemberCount",
                "Expression": "External Member Count"
            },
            {
                "Name": "ExchangeReceivedEmailCount",
                "Expression": "Exchange Received Email Count"
            },
            {
                "Name": "SharePointActiveFileCount",
                "Expression": "SharePoint Active File Count"
            },
            {
                "Name": "YammerPostedMessageCount",
                "Expression": "Yammer Posted Message Count"
            },
            {
                "Name": "YammerReadMessageCount",
                "Expression": "Yammer Read Message Count"
            },
            {
                "Name": "YammerLikedMessageCount",
                "Expression": "Yammer Liked Message Count"
            },
            {
                "Name": "ExchangeMailboxTotalItemCount",
                "Expression": "Exchange Mailbox Total Item Count"
            },
            {
                "Name": "TeamsChannelMessagesCount",
                "Expression": "Teams Channel Messages Count"
            },
            {
                "Name": "TeamsMeetingsOrganizedCount",
                "Expression": "Teams Meetings Organized Count"
            },
            {
                "Name": "ExchangeMailboxStorageUsedByte",
                "Expression": "Exchange Mailbox Storage Used (Byte)"
            },
            {
                "Name": "SharePointTotalFileCount",
                "Expression": "SharePoint Total File Count"
            },
            {
                "Name": "SharePointSiteStorageUsedByte",
                "Expression": "SharePoint Site Storage Used (Byte)"
            }
        ]
    }
}