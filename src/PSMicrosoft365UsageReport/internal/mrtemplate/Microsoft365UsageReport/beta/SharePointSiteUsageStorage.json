{
    "Name": "SharePointSiteUsageStorage",
    "Description": "Get the trend of storage allocated and consumed during the reporting period.",
    "Utility": "Microsoft365",
    "Service": "SharepointOnLine",
    "Type": "Tenant",
    "Version": "beta",
    "Format": [
        "text/csv",
        "application/json"
    ],
    "Definition": {
        "Function": "getSharePointSiteUsageStorage",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ]
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportDate",
                "Expression": "Report Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "SiteType",
                "Expression": "Site Type"
            },
            {
                "Name": "StorageUsedByte",
                "Expression": "Storage Used (Byte)"
            }
        ]
    }
}