                "30",
                "90",
                "180"
            ]
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportDate",
                "Expression": "Report Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "SiteType",
                "Expression": "Site Type"
            },
            {
                "Name": "Total",
                "Expression": "Total"
            },
            {
                "Name": "Active",
                "Expression": "Active"
            }
        ]
    }
}