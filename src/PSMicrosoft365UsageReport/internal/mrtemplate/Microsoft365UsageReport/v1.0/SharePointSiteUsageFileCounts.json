    "Service": "SharepointOnLine",
    "Type": "Tenant",
    "Version": "v1.0",
    "Format": [
        "text/csv"
    ],
    "Definition": {
        "Function": "getSharePointSiteUsageFileCounts",
        "Parameters": {
            "Days": [
