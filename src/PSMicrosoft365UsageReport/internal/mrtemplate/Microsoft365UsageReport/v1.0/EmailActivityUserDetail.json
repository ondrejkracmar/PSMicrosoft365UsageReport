{
    "Name": "EmailActivityUserDetail",
    "Description": "Get details about email activity users have performed.",
    "Utility": "Microsoft365",
    "Service": "ExchangeOnline",
    "Type": "User",
    "Version": "v1.0",
    "Format": ["text/csv"],
    "Definition": {
        "Function": "getEmailActivityUserDetail",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ],
            "Date": "YYYY-MM-DD"
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "UserPrincipalName",
                "Expression": "User Principal Name"
            },
            {
                "Name": "DisplayName",
                "Expression": "Display Name"
            },
            {
                "Name": "LastActivityDate",
                "Expression": "Last Activity Date"
            },
            {
                "Name": "SendCount",
                "Expression": "Send Count"
            },
            {
                "Name": "ReceiveCount",
                "Expression": "Receive Count"
            }
        ]
    }
}