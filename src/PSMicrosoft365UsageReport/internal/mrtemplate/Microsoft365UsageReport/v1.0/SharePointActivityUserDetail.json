{
    "Name": "SharePointActivityUserDetail",
    "Description": "Get details about SharePoint activity by user.",
    "Utility": "Microsoft365",
    "Service": "SharepointOnLine",
    "Type": "User",
    "Version": "v1.0",
    "Format": [
        "text/csv"
    ],
    "Definition": {
        "Function": "getSharePointActivityUserDetail",
        "Parameters": {
            "Days": [
                "7",
                "30",
                "90",
                "180"
            ],
            "Date": "YYYY-MM-DD"
        },
        "ResponseProperty": [
            {
                "Name": "ReportRefreshDate",
                "Expression": "Report Refresh Date"
            },
            {
                "Name": "ReportPeriod",
                "Expression": "Report Period"
            },
            {
                "Name": "UserPrincipalName",
                "Expression": "User Principal Name"
            },
            {
                "Name": "IsDeleted",
                "Expression": "Is Deleted"
            },
            {
                "Name": "Deleted Date",
                "Expression": "Deleted Date"
            },
            {
                "Name": "LastActivityDate",
                "Expression": "Last Activity Date"
            },
            {
                "Name": "ViewedOrEditedFileCount",
                "Expression": "Viewed Or Edited File Count"
            },
            {
                "Name": "SyncedFileCount",
                "Expression": "Synced File Count"
            },
            {
                "Name": "SyncedFileCount",
                "Expression": "Synced File Count"
            },
            {
                "Name": "SharedInternallyFileCount",
                "Expression": "Shared Internally File Count"
            },
            {
                "Name": "SharedExternallyFileCount",
                "Expression": "Shared Externally File Count"
            },
            {
                "Name": "Visited Page Count",
                "Expression": "Visited Page Count"
            },
            {
                "Name": "AssignedProducts",
                "Expression": "Assigned Products"
            }
        ]
    }
}